{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-shell",
  "version": "0.1.0",
  "identifier": "com.mridu.desktop-shell",
  "build": {
    "frontendDist": "../../backend/src/main/resources/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Retail ERP",
        "width": 1280,
        "height": 800,
        "url": "http://localhost:8080"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/custom-jre": "custom-jre",
      "../../backend/build/libs/backend-0.0.1-SNAPSHOT.jar": "backend.jar"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_GENERATED_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPO_NAME/releases/latest/download/latest.json"
      ]
    }
  }
}