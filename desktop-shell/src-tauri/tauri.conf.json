{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-shell",
  "version": "0.1.3",
  "identifier": "com.mridu.desktop-shell",
  "build": {
    "frontendDist": "../../backend/src/main/resources/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Retail ERP",
        "width": 1280,
        "height": 800,
        "url": "http://localhost:8080"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/custom-jre": "custom-jre",
      "../../backend/build/libs/backend-0.0.1-SNAPSHOT.jar": "backend.jar"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0Q0E0MjA3MEY2QTQ0RTYKUldUbVJHb1BCMExLdERkTW5iamkxNC9qV2dWN0NvR2tCQlFmbXBTQXFORlBGMVlVOEpySGM3aEQK",
      "endpoints": [
        "https://github.com/mridul01r/TrustKhata/releases/latest/download/latest.json"
      ]
    }
  }
}